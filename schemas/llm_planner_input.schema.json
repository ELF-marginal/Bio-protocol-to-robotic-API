{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPlannerInput",
  "type": "object",
  "required": [
    "protocol_id",
    "operations",
    "operation_api_groups",
    "available_apis",
    "lab_state_initial",
    "lab_state_expected",
    "planner_task_instruction",
    "notice"
  ],
  "properties": {
    "protocol_id": { "type": "string" },
    "operations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "operation_api_groups": {
      "type": "array",
      "items": { "type": "object" }
    },
    "available_apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "parameters"],
        "properties": {
          "name": { "type": "string" },
          "parameters": { "type": "object" }
        }
      }
    },
    "lab_state_initial": { "type": "object" },
    "lab_state_expected": { "type": "object" },
    "planner_task_instruction": { "type": "string" },
    "notice": { "type": "string" }
  }
}
