{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPlannerOutput",
  "type": "object",
  "required": [
    "decision",
    "reasoning_summary",
    "workflow",
    "merge_summary",
    "assumptions"
  ],
  "properties": {
    "decision": { "type": "string" },
    "reasoning_summary": { "type": "string" },
    "workflow": {
      "type": "object",
      "required": ["api_calls"],
      "properties": {
        "api_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["api", "args"],
            "properties": {
              "call_id": { "type": "string" },
              "api": { "type": "string" },
              "args": { "type": "object" },
              "source_step_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "merge_summary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
