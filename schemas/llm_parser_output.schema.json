{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMParserOutput",
  "type": "object",
  "required": ["decision", "reasoning_summary", "parsed_protocol", "assumptions"],
  "properties": {
    "decision": { "type": "string" },
    "reasoning_summary": { "type": "string" },
    "parsed_protocol": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "protocol_id": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "entities", "parameters"],
            "properties": {
              "step_id": { "type": "string" },
              "raw_text": { "type": "string" },
              "action": { "type": "string" },
              "entities": { "type": "object" },
              "parameters": { "type": "object" }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
