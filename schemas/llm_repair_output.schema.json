{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMRepairOutput",
  "type": "object",
  "required": ["decision", "reasoning_summary", "operations", "assumptions"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["repair", "skip"]
    },
    "reasoning_summary": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "target_call_id"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["insert_before", "insert_after", "replace_call", "delete_call"]
          },
          "target_call_id": { "type": "string" },
          "new_call": {
            "type": "object",
            "properties": {
              "api": { "type": "string" },
              "args": { "type": "object" }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
