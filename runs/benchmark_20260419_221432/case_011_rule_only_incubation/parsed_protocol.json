{
  "protocol_id": "case_011_rule_only_incubation",
  "steps": [
    {
      "step_id": "s1",
      "raw_text": "Take the sample tube from the fridge",
      "action": "retrieve",
      "entities": {
        "target": "sample tube",
        "source": "fridge"
      },
      "parameters": {}
    },
    {
      "step_id": "s2",
      "raw_text": "place it on the bench",
      "action": "place",
      "entities": {
        "target": "sample tube",
        "destination": "bench"
      },
      "parameters": {}
    },
    {
      "step_id": "s3",
      "raw_text": "add 50 uL lysis buffer",
      "action": "add",
      "entities": {
        "target": "sample tube",
        "reagent": "lysis buffer"
      },
      "parameters": {
        "volume_ul": 50
      }
    },
    {
      "step_id": "s4",
      "raw_text": "cap it",
      "action": "cap",
      "entities": {
        "target": "sample tube"
      },
      "parameters": {}
    },
    {
      "step_id": "s5",
      "raw_text": "incubate at 37C for 10 minutes",
      "action": "incubate",
      "entities": {
        "target": "sample tube"
      },
      "parameters": {
        "temperature_c": 37,
        "duration_min": 10
      }
    },
    {
      "step_id": "s6",
      "raw_text": "then put it back into the fridge",
      "action": "store",
      "entities": {
        "target": "sample tube",
        "destination": "fridge"
      },
      "parameters": {}
    }
  ]
}